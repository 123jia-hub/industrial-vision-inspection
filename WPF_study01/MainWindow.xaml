<Window x:Class="WPF_study01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_study01"
        mc:Ignorable="d"
        xmlns:vm="clr-namespace:WPF_study01.ViewModels"
        xmlns:vw="clr-namespace:WPF_study01.Veiws"
        Title="视觉检测系统" Height="450" Width="800">
    
    <!--映射表：ViewModel -> View -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
            <vw:MonitorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <vw:HistoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <vw:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!--左边菜单列-->
            <ColumnDefinition Width="150"/>
            <!--右边空间补全-->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!--左边菜单栏设置-->
        <StackPanel Grid.Column="0" Background="Gray">
            <Button Content="监控" FontSize="20" Height="50" Margin="5" Command="{Binding GoMonitorCommand}"/>
            <Button Content="历史" FontSize="20" Height="50" Margin="5" Command="{Binding GoHistoryCommand}"/>
            <Button Content="设置" FontSize="20" Height="50" Margin="5" Command="{Binding GoSettingsCommand}"/>
        </StackPanel>
        
        <!--右侧内容区-->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}"/>
    </Grid>
        
</Window>
